# Copy this file to ".env" for LOCAL testing only.
# In GitHub Actions, these same names are set as repo Secrets instead —
# never commit a real .env file to your repo.

IG_USER_ID=your_instagram_business_account_id
IG_ACCESS_TOKEN=your_long_lived_access_token
PUBLIC_RAW_BASE_URL=https://raw.githubusercontent.com/your-username/your-repo/main/generated
